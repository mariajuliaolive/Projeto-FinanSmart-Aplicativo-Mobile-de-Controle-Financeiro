<?xml version="1.0" encoding="utf-8"?>
<!--
  FRENTE DO ICONE: o losango branco vazado do logo do FinanSmart
  (o mesmo da Splash e da tela Sobre).

  Ele e um quadrado de cantos arredondados (26dp) desenhado so com o
  contorno (strokeWidth) e girado 45 graus em volta do centro (54,54).
  Fica dentro da "zona segura" de 66dp no meio, entao nenhum formato
  de recorte corta o desenho.

  Tambem e usado como icone MONOCROMATICO (Android 13+ "icones com tema"):
  o sistema pinta o branco com a cor do papel de parede.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="45">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.2"
            android:pathData="M48.5,41 H59.5 A7.5,7.5 0 0 1 67,48.5 V59.5 A7.5,7.5 0 0 1 59.5,67 H48.5 A7.5,7.5 0 0 1 41,59.5 V48.5 A7.5,7.5 0 0 1 48.5,41 Z" />
    </group>
</vector>
